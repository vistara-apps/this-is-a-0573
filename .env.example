# SpeakTaskr Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Turnkey API Configuration (for payments)
VITE_TURNKEY_API_KEY=your_turnkey_api_key
VITE_TURNKEY_BASE_URL=https://api.turnkey.tech

# Optional: Farcaster/Neynar API (for social features)
VITE_NEYNAR_API_KEY=your_neynar_api_key

# Development Mode (set to 'true' to use mock services)
VITE_DEV_MODE=true
